# Copy this file to keystore.properties (same folder) and fill in real values.
# keystore.properties is git-ignored — never commit real passwords.
#
# Generate the keystore first (one-time, on a machine with a JDK installed):
#   keytool -genkeypair -v -keystore student-life-release.jks -alias studentlife -keyalg RSA -keysize 2048 -validity 10000
#
storeFile=/absolute/path/to/student-life-release.jks
storePassword=CHANGE_ME
keyAlias=studentlife
keyPassword=CHANGE_ME
