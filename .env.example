# VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY: from your Supabase project
# dashboard -> Settings -> API. The anon key is safe to ship client-side;
# access control is enforced by Row Level Security policies (see supabase/schema.sql).
VITE_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
VITE_SUPABASE_ANON_KEY="MY_SUPABASE_ANON_KEY"

# GEMINI_API_KEY is NOT a client env var. It is set as a Supabase Edge Function
# secret instead, so it never ships inside the app bundle:
#   supabase secrets set GEMINI_API_KEY="MY_GEMINI_API_KEY"
